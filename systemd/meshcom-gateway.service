[Unit]
Description=MeshCom Email Gateway daemon
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=ok2zaw
Group=ok2zaw
WorkingDirectory=/home/ok2zaw/meshcom-gateway
EnvironmentFile=-/home/ok2zaw/meshcom-gateway/.env
ExecStart=/home/ok2zaw/meshcom-gateway/.venv/bin/python /home/ok2zaw/meshcom-gateway/gateway.py
Restart=on-failure
RestartSec=5
TimeoutStopSec=15
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target

[Unit]
Description=MeshCom Gateway web UI
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=ok2zaw
Group=ok2zaw
WorkingDirectory=/home/ok2zaw/meshcom-gateway
EnvironmentFile=-/home/ok2zaw/meshcom-gateway/.env
ExecStart=/home/ok2zaw/meshcom-gateway/.venv/bin/waitress-serve --threads=4 --listen=0.0.0.0:8899 webapp:app
Restart=on-failure
RestartSec=5
TimeoutStopSec=15
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target

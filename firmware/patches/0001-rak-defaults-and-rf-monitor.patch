+bool externMonitorReady()
+{
+  return bEXTUDP && hasExternIPaddress && neth.hasIPaddress &&
+         strlen(meshcom_settings.node_extern) > 7;
+}
+
+bool sendExternMonitor(const uint8_t *json, uint16_t len)
+{
+  if(!externMonitorReady() || !json || !len)
+    return false;
+  if(UdpExtern.beginPacket(apip, EXTERN_PORT) != 1)
+    return false;
+  if(UdpExtern.write(json, len) != len)
+  {
+    resetExternUDP();  // discard the incomplete datagram
+    return false;
+  }
+  return UdpExtern.endPacket() == 1;
+}

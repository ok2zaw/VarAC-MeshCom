# Copy this file to .env and fill in your real values.
# The gateway reads both prefixed and unprefixed keys.
MESHCOM_MESH_NODE_IP=192.168.1.50
MESHCOM_MESH_UDP_PORT=1799
MESHCOM_LISTEN_IP=0.0.0.0
MESHCOM_MESH_GROUP=12345
MESHCOM_SMTP_HOST=smtp.example.com
MESHCOM_SMTP_PORT=587
MESHCOM_SMTP_USER=gateway@example.com
MESHCOM_SMTP_PASSWORD=changeme
MESHCOM_SMTP_USE_TLS=true
MESHCOM_MAIL_FROM=meshcom-gateway@example.com
MESHCOM_MAIL_TO=you@example.com
MESHCOM_MAILDIR_NEW=/home/pi/Maildir/new
MESHCOM_MAILDIR_CUR=/home/pi/Maildir/cur
MESHCOM_IMAP_HOST=imap.example.com
MESHCOM_IMAP_PORT=993
MESHCOM_IMAP_USER=gateway@example.com
MESHCOM_IMAP_PASSWORD=secret
MESHCOM_IMAP_USE_SSL=true
MESHCOM_IMAP_FOLDER=INBOX
MESHCOM_POLL_INTERVAL_SECONDS=5
MESHCOM_MAX_MESH_PAYLOAD=150
MESHCOM_CALLSIGN=OK2ZAW-10
MESHCOM_WEB_USERNAME=admin
MESHCOM_WEB_PASSWORD=changeme
